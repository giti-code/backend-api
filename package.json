{
  "name": "backend-api",
  "version": "0.1.0",
  "description": "Production-ready API-first backend built with TypeScript, Node.js, Express, PostgreSQL and Prisma",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
